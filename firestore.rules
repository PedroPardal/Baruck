rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // ---- @usuário: nome -> uid (leitura pública para checar disponibilidade) ----
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---- Perfis ----
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;

      match /friends/{friendId} {
        allow read: if signedIn() && uid() == userId;
        allow write: if signedIn() && uid() == userId;
        // quem aceita o pedido se adiciona na lista de quem pediu
        allow create: if signedIn() && uid() == friendId
          && exists(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId));
        allow delete: if signedIn() && uid() == friendId;
      }

      match /friendRequests/{reqId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && reqId == uid()
          && request.resource.data.fromUid == uid();
      }

      match /inbox/{itemId} {
        allow read, update, delete: if signedIn() && uid() == userId;
        allow create: if signedIn();
      }

      match /tokens/{tokenId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // ---- Lavouras ----
    match /farms/{farmId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && uid() in request.resource.data.members;
      allow update: if signedIn()
        && (resource.data.ownerUid == uid() || uid() in resource.data.members);
      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // estufas, safras, colheitas, custos, lembretes
      match /{sub}/{docId} {
        allow read, write: if signedIn() &&
          uid() in get(/databases/$(database)/documents/farms/$(farmId)).data.members;
      }
    }
  }
}
